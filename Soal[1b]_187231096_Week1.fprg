    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="reamur, celcius, fahrenheit" type="Real" array="False" size=""/>
            <output expression="&quot;masukkan suhu dalam reamur&quot;" newline="True"/>
            <input variable="reamur"/>
            <assign variable="celcius" expression="reamur/0.8"/>
            <assign variable="fahrenheit" expression="(reamur*2.25)+32"/>
            <output expression="&quot;hasil konversi reamur ke celcius&quot;" newline="True"/>
            <output expression="celcius" newline="True"/>
            <output expression="&quot;hasil konversi reamur ke fahrenheit&quot;" newline="True"/>
            <output expression="fahrenheit" newline="True"/>
        </body>
    </function>
</flowgorithm>

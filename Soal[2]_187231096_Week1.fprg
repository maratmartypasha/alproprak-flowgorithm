<flowgorithm fileversion="4.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="Marat Martypasha"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2024-02-06 08:12:30 PM"/>
        <attribute name="created" value="TWFyYXQgTWFydHlwYXNoYTtMQVBUT1AtVFI0QzlFREw7MjAyNC0wMi0wNjswNzowNTowMyBQTTszOTIy"/>
        <attribute name="edited" value="TWFyYXQgTWFydHlwYXNoYTtMQVBUT1AtVFI0QzlFREw7MjAyNC0wMi0wNjswODoxMjozMCBQTTsxOzQwMjk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="bil1, bil2, bil3, bil4, hasil, n" type="Integer" array="False" size=""/>
            <output expression="&quot;masukkan bilangan bulat 4 digit (n)&quot;" newline="True"/>
            <input variable="n"/>
            <assign variable="bil1" expression="n%10"/>
            <assign variable="n" expression="n/10"/>
            <assign variable="bil2" expression="n%10"/>
            <assign variable="n" expression="n/10"/>
            <assign variable="bil3" expression="n%10"/>
            <assign variable="n" expression="n/10"/>
            <assign variable="bil4" expression="n%10"/>
            <assign variable="hasil" expression="bil1+bil2+bil3+bil4"/>
            <output expression="&quot;hasil jumlah 4 digit&quot;" newline="True"/>
            <output expression="hasil" newline="True"/>
        </body>
    </function>
</flowgorithm>

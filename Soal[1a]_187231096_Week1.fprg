    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="celcius, reamur, fahrenheit" type="Real" array="False" size=""/>
            <output expression="&quot;masukkan suhu dalam celcius&quot;" newline="True"/>
            <input variable="celcius"/>
            <assign variable="reamur" expression="4/5*celcius"/>
            <assign variable="fahrenheit" expression="9/5*celcius+32"/>
            <output expression="&quot;hasil konversi celcius ke reamur&quot;" newline="True"/>
            <output expression="reamur" newline="True"/>
            <output expression="&quot;hasil konversi celcius ke fahrenheit&quot;" newline="True"/>
            <output expression="fahrenheit" newline="True"/>
        </body>
    </function>
</flowgorithm>
